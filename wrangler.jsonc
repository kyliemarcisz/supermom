{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supermom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sms"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supermom",
      "database_id": "19200c92-b13d-44cc-8ef8-d58b464b7172",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CLAUDE_MODEL": "claude-haiku-5-5"
  },
  "observability": { "enabled": true }
}
